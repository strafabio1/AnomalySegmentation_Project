    {
      "cell_type": "code",
      "execution_count": 73,
      "metadata": {
        "id": "0CabM3tW00PK"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Initializing COCO Panoptic model...\n",
            "Weights successfully loaded from weights/eomt_coco.bin!\n",
            "Initializing Cityscapes Semantic model...\n",
            "Weights successfully loaded from weights/eomt_cityscapes.bin!\n"
          ]
